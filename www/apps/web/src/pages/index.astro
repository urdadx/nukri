---
import { Copy01Icon, PlayIcon } from "@hugeicons/core-free-icons";
import CheckCircle from "../components/CheckCircle.astro";
import GithubMark from "../components/GithubMark.astro";
import Icon from "../components/Icon.astro";
import Logo from "../components/Logo.astro";
import Install from "../components/Install.astro";
import Faq from "../components/Faq.astro";
import Features from "../components/Features.astro";
import Footer from "../components/Footer.astro";
import GradientBackground from "../components/GradientBackground.astro";
import Bolt from "../components/Bolt.astro";
import TryArrow from "../components/TryArrow.astro";
import Tux from "../components/Tux.astro";
import NukriDemo from "../components/nukri-demo/NukriDemo.astro";
import Layout from "../layouts/Layout.astro";
import { siteLinks } from "../links";

const installCommand = "curl -fsSL https://nukri.urdadx.com/install.sh | sh";
const button =
  "inline-flex h-10 items-center gap-2 rounded-lg px-4 text-sm font-medium whitespace-nowrap transition-colors";
---

<Layout revealHeader>
  <main>
    <section class="pb-12">
      <div class="mx-auto max-w-3xl px-4 pt-16 pb-14 md:pt-24">
        <div class="w-fit" data-header-trigger><Logo size={44} /></div>
        <h1
          class="mt-8 max-w-lg text-3xl font-medium tracking-[-0.5px] text-pretty text-heading xl:text-4xl xl:tracking-[-0.7px]"
        >
          <span class="whitespace-nowrap">Fast <Bolt class="inline-block size-[0.9em] align-[-0.08em] text-[#eab308] dark:text-[#facc15]" /></span>{" "}
          and elegant terminal file manager for{" "}
          <span class="whitespace-nowrap"><Tux class="inline-block align-[-0.12em]" /> Linux.</span>
        </h1>
        <p class="mt-4 text-3xl leading-9 font-medium tracking-[-0.4px] text-pretty text-heading-muted">
          Browse, preview and manage your files without leaving the terminal.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-2">
          <a href={siteLinks.getStarted} target="_blank" class:list={[button, "bg-fg text-bg hover:bg-fg/85"]}>Get started</a>
          <a href={siteLinks.github} target="_blank" class:list={[button, "bg-fg/10 text-fg hover:bg-fg/15"]}>
            <GithubMark size={16} />
            GitHub
          </a>
          <button
            type="button"
            id="copy-install"
            data-command={installCommand}
            class:list={[button, "bg-fg/10 text-fg hover:bg-fg/15"]}
          >
            <Icon icon={Copy01Icon} data-icon="copy" />
            <CheckCircle data-icon="check" class="hidden size-4 text-green-600 dark:text-green-500" />
            Copy install command
          </button>
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-7xl px-3 sm:px-4 lg:px-6" data-try-area>
        <TryArrow class="absolute right-10 bottom-full z-10 -mb-1 hidden text-fg/70 sm:flex lg:right-20" />
        <div class="relative isolate overflow-hidden rounded-xl px-3 py-8 sm:px-6 sm:py-10 lg:px-10 lg:py-12">
          <GradientBackground />
          <!--
            Phones get a screenshot and the launch video: the terminal is too small to use
            there. The video loads after the page does (see the script below), so it never
            holds up first paint.
          -->
          <div class="relative sm:hidden" data-demo-video>
            <img
              src="/demo.png"
              alt="Nukri with the Places sidebar, the file list of a home folder, and a preview of the selected folder"
              width="1159"
              height="744"
              class="block w-full rounded-lg shadow-lg"
              data-demo-poster
            />
            <button
              type="button"
              class="absolute top-1/2 left-1/2 inline-flex h-12 -translate-x-1/2 -translate-y-1/2 items-center gap-2.5 rounded-full bg-linear-to-b from-white/95 to-neutral-200/90 py-1.5 pr-5 pl-1.5 text-sm font-semibold whitespace-nowrap text-neutral-900 shadow-[inset_0_1px_0_rgb(255_255_255),inset_0_-1px_0_rgb(0_0_0/0.08),0_10px_30px_rgb(0_0_0/0.35)] ring-1 ring-black/10 backdrop-blur-md active:scale-[0.97]"
              data-demo-play
            >
              <span class="flex size-9 items-center justify-center rounded-full bg-neutral-900 text-white shadow-[inset_0_1px_0_rgb(255_255_255/0.25)]">
                <Icon icon={PlayIcon} size={16} class="translate-x-px" />
              </span>
              Watch demo
            </button>
            <video
              class="aspect-video w-full rounded-lg bg-black shadow-lg"
              hidden
              data-src="/demo-video.mp4"
              preload="none"
              playsinline
              controls
              data-demo-player
            ></video>
          </div>
          <div class="hidden sm:block">
            <NukriDemo />
          </div>
        </div>
        <p class="mt-4 hidden text-center text-md text-muted sm:block">
          <span class="pointer-coarse:hidden">
            Click the terminal, then use <kbd>j</kbd> <kbd>k</kbd> to move, <kbd>↵</kbd> to open,{" "}
            <kbd>h</kbd> to go back, <kbd>T</kbd> to switch theme
          </span>
          <span class="hidden pointer-coarse:inline">Tap a file or folder to explore</span>
        </p>
      </div>
    </section>

    <Features />

    <Install />

    <Faq />
  </main>

  <Footer />
</Layout>

<script>
  // The phone demo: fetch the video once the page has loaded and gone idle, so
  // the tap plays at once without the video competing with first paint. Wider
  // screens get the live terminal and never fetch it; Save-Data skips the head
  // start and loads it on the tap instead.
  const demo = document.querySelector<HTMLElement>("[data-demo-video]");
  const player = demo?.querySelector<HTMLVideoElement>("[data-demo-player]");
  const loadVideo = () => {
    if (!player || player.src) return;
    player.src = player.dataset.src ?? "";
    player.preload = "auto";
    player.load();
  };
  const phone = matchMedia("(max-width: 639px)").matches;
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
  if (phone && !saveData) {
    const idle = () => ("requestIdleCallback" in window ? requestIdleCallback(loadVideo) : setTimeout(loadVideo, 200));
    if (document.readyState === "complete") idle();
    else addEventListener("load", idle, { once: true });
  }
  demo?.querySelector("[data-demo-play]")?.addEventListener("click", (event) => {
    if (!player) return;
    loadVideo();
    // The hidden attribute, not the class: Tailwind's preflight enforces it over
    // the display utilities these elements carry.
    const poster = demo.querySelector<HTMLElement>("[data-demo-poster]");
    if (poster) poster.hidden = true;
    (event.currentTarget as HTMLElement).hidden = true;
    player.hidden = false;
    void player.play();
  });

  const button = document.getElementById("copy-install");
  let reset: ReturnType<typeof setTimeout> | undefined;
  button?.addEventListener("click", async () => {
    await navigator.clipboard.writeText(button.dataset.command ?? "");
    const copy = button.querySelector('[data-icon="copy"]');
    const check = button.querySelector('[data-icon="check"]');
    copy?.classList.add("hidden");
    check?.classList.remove("hidden");
    clearTimeout(reset);
    reset = setTimeout(() => {
      copy?.classList.remove("hidden");
      check?.classList.add("hidden");
    }, 1500);
  });
</script>

<style>
  /* The copy button gives a little: it presses in, and the tick pops in when copied. */
  #copy-install {
    transition:
      background-color 150ms,
      transform 120ms;
  }

  @media (prefers-reduced-motion: no-preference) {
    #copy-install:active {
      transform: scale(0.97);
    }

    #copy-install :global([data-icon="check"]:not(.hidden)) {
      animation: pop 320ms cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    #copy-install :global([data-icon="copy"]:not(.hidden)) {
      animation: fade-in 200ms ease-out;
    }
  }

  @keyframes pop {
    from {
      opacity: 0;
      scale: 0.4;
      rotate: -20deg;
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
      scale: 0.8;
    }
  }
</style>
