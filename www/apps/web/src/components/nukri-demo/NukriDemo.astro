---
/*
Nukri running in the page: a terminal grid in one of Nukri's themes that you can
click and drive with Nukri's keys. The window is a fixed number of rows tall and,
like a real terminal, fits as many columns as its width holds, so the layout
changes with the width just as the app's does. The server draws a first frame at
the desktop width; the script below takes over. To change the theme, dispatch a
"nukri:theme" event with the theme's name as its detail on the figure.
*/
import { Demo, rows } from "./demo";
import { toHTML } from "./render";

interface Props {
  class?: string;
  /** A bundled theme's name, such as "nord". */
  theme?: string;
  /** How many rows tall the terminal is. */
  rows?: number;
}

const { class: className, theme = "kaolin", rows: height = rows } = Astro.props;
// The columns a 1230 pixel wide screen holds at the desktop font size.
const demo = new Demo(146, height, theme);
---

<figure
  class:list={["nukri-demo", className]}
  style={`--bg: ${demo.theme.bg}; --rows: ${height}`}
  data-theme={theme}
  data-rows={height}
>
  <div class="bar" aria-hidden="true"><span class="close"></span><span class="minimize"></span><span class="zoom"></span></div>
  <div
    class="screen"
    tabindex="0"
    role="application"
    aria-label="Nukri demo. Click it, then press j and k to move, enter to open a folder and h to go back."
    set:html={toHTML(demo.frame())}
  />
</figure>

<script>
  import { Demo, hint, touchHint } from "./demo";
  import { toHTML } from "./render";
  import { themes } from "./themes";

  for (const screen of document.querySelectorAll<HTMLElement>(".nukri-demo .screen")) {
    const figure = screen.closest<HTMLElement>(".nukri-demo")!;
    const demo = new Demo(0, Number(figure.dataset.rows), figure.dataset.theme);
    const touch = matchMedia("(hover: none)").matches;
    const idleStatus = touch ? touchHint : hint;
    demo.status = idleStatus;
    let cell = { width: 1, height: 1 };

    const draw = () => {
      screen.innerHTML = toHTML(demo.frame());
      // The window chrome takes the theme's background too.
      figure.style.setProperty("--bg", demo.theme.bg);
    };

    // Fit the columns to the screen, as a terminal does when its window is resized.
    const fit = () => {
      const size = parseFloat(getComputedStyle(screen).fontSize);
      cell = { width: size * 0.6, height: (size * 4) / 3 };
      const cols = Math.floor(screen.clientWidth / cell.width);
      if (cols < 1 || cols === demo.cols) return;
      demo.cols = cols;
      draw();
    };
    document.fonts.ready.then(fit);

    figure.addEventListener("nukri:theme", (event) => {
      const name = (event as CustomEvent<string>).detail;
      if (!themes[name]) return;
      demo.theme = themes[name];
      // What Nukri's status line says once a theme is picked.
      demo.status = `Theme: ${name}`;
      draw();
    });
    new ResizeObserver(fit).observe(screen);

    // The footer explains the keys while the demo is idle, and reads like Nukri once keys go to it.
    screen.addEventListener("focus", () => {
      demo.status = "Ready";
      draw();
    });
    screen.addEventListener("blur", () => {
      demo.status = idleStatus;
      draw();
    });

    screen.addEventListener("keydown", (event) => {
      if (event.ctrlKey || event.metaKey || event.altKey) return;
      if (demo.key(event.key)) {
        event.preventDefault();
        draw();
      }
    });

    screen.addEventListener("click", (event) => {
      const box = screen.getBoundingClientRect();
      const x = Math.floor((event.clientX - box.left) / cell.width);
      const y = Math.floor((event.clientY - box.top) / cell.height);
      if (demo.click(x, y, event.detail === 2)) draw();
    });

    // The wheel moves the selection, but only once the demo has focus, so
    // scrolling past it on the page still scrolls the page.
    let wheel = 0;
    screen.addEventListener(
      "wheel",
      (event) => {
        if (document.activeElement !== screen) return;
        event.preventDefault();
        wheel += event.deltaY;
        const steps = Math.trunc(wheel / 40);
        if (!steps) return;
        wheel -= steps * 40;
        demo.move(steps);
        demo.status = "Ready";
        draw();
      },
      { passive: false },
    );
  }
</script>

<style>
  /* The window: Shiori's style, with macOS window buttons for chrome. */
  .nukri-demo {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--window-border);
    border-radius: 12px;
    transition:
      border-color 150ms,
      outline-color 150ms;
    outline: 2px solid transparent;
    outline-offset: 3px;
    background: var(--bg);
    box-shadow:
      rgb(255 255 255 / 0.04) 0 0 0 0.5px inset,
      rgb(255 255 255 / 0.04) 0 0.5px 0 0 inset,
      var(--window-shadow);
  }

  .nukri-demo:hover {
    border-color: color-mix(in oklch, var(--window-border), white 25%);
  }

  /* Keys go to the demo while it has focus; the ring says so. */
  .nukri-demo:focus-within {
    outline-color: rgb(139 233 253 / 0.6);
  }

  .bar {
    display: flex;
    flex: none;
    gap: 8px;
    align-items: center;
    height: 36px;
    padding-left: 14px;
  }

  .bar span {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 0.5px rgb(0 0 0 / 0.2);
  }

  .bar .close {
    background: #ff5f57;
  }

  .bar .minimize {
    background: #febc2e;
  }

  .bar .zoom {
    background: #28c840;
  }

  .screen {
    --cw: 0.6em;
    --ch: calc(4em / 3);
    --line: calc(2em / 15);
    position: relative;
    height: calc(var(--rows) * var(--ch));
    overflow: hidden;
    font-family: "Geist Mono Nerd", ui-monospace, monospace;
    font-size: 11px;
    font-kerning: none;
    font-variant-ligatures: none;
    cursor: pointer;
    user-select: none;
    outline: none;
  }

  @media (min-width: 640px) {
    .screen {
      font-size: 12px;
    }
  }

  @media (min-width: 1024px) {
    .screen {
      font-size: 14px;
    }
  }

  .screen :global(.row) {
    height: var(--ch);
    line-height: var(--ch);
    white-space: pre;
  }

  .screen :global(.b) {
    font-weight: 700;
  }

  /* An icon takes one cell even when a fallback font draws it wider. */
  .screen :global(.i) {
    display: inline-block;
    width: var(--cw);
    text-align: center;
  }

  /* A preview picture over its cells, as kitty or sixel would place it. */
  .screen :global(.pic) {
    position: absolute;
    left: calc(var(--x) * var(--cw));
    top: calc(var(--y) * var(--ch));
    width: calc(var(--w) * var(--cw));
    height: calc(var(--h) * var(--ch));
    object-fit: cover;
    pointer-events: none;
  }

  /* Box drawing lines run through the middle of their cells. */
  .screen :global(.box) {
    position: absolute;
    left: calc(var(--x) * var(--cw) + var(--cw) / 2 - var(--line) / 2);
    top: calc(var(--y) * var(--ch) + var(--ch) / 2 - var(--line) / 2);
    width: calc((var(--w) - 1) * var(--cw) + var(--line));
    height: calc((var(--h) - 1) * var(--ch) + var(--line));
    border: var(--line) solid;
    border-radius: calc(5em / 15);
    pointer-events: none;
  }
</style>
