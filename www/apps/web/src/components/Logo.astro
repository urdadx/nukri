---
/*
The Nukri mark: a ball shaded from light at the top to deep at the bottom, after
Shiori's orange one, in grey.
*/
interface Props {
  size?: number;
  class?: string;
}

const { size = 24, class: className } = Astro.props;
// Each logo needs its own gradient ids, since the page can show several.
const id = `logo-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 100 100"
  class={className}
  aria-hidden="true"
>
  <defs>
    <linearGradient id={`${id}-fill`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#e5e5e5" />
      <stop offset="0.5" stop-color="#9a9a9a" />
      <stop offset="1" stop-color="#4d4d4d" />
    </linearGradient>
    <radialGradient id={`${id}-shine`} cx="0.38" cy="0.28" r="0.45">
      <stop offset="0" stop-color="#ffffff" stop-opacity="0.18" />
      <stop offset="1" stop-color="#ffffff" stop-opacity="0" />
    </radialGradient>
  </defs>
  <circle cx="50" cy="50" r="50" fill={`url(#${id}-fill)`} />
  <circle cx="50" cy="50" r="50" fill={`url(#${id}-shine)`} />
</svg>
