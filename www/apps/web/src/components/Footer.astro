---
import Logo from "./Logo.astro";
import { siteLinks } from "../links";

const nav = [
  { href: siteLinks.features, label: "Features" },
  { href: siteLinks.docs, label: "Docs" },
  { href: siteLinks.releases, label: "Releases" },
  { href: siteLinks.github, label: "GitHub" },
];
const link = "transition-colors hover:text-fg";
---

<footer class="mt-8 border-t border-line">
  <div class="mx-auto flex max-w-2xl flex-col items-center gap-5 px-4 py-12 text-center text-sm text-muted">
    <Logo size={28} />
    <nav class="flex flex-wrap justify-center gap-x-5 gap-y-2">
      {nav.map((item) => <a href={item.href} class={link}>{item.label}</a>)}
    </nav>
    <p>
      Free and open source under the <a href={`${siteLinks.github}/blob/HEAD/LICENSE`} class:list={[link, "underline underline-offset-2"]}>MIT License</a>.
    </p>
    <p class="text-xs text-muted/80">
    &copy;  Made by <a target="_blank" href="https://x.com/urdaadx" class:list={[link, "underline underline-offset-2"]}>urdadx</a>. 
    </p>
  </div>
</footer>
